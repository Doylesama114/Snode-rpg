{
  "name": "snowd-skill-tree",
  "version": "1.0.8048",
  "description": "斯诺德跑团 - RPG角色管理工具",
  "author": "snowd",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node embed-env-for-dist.js",
    "dist": "node ./sync-check.js && node --require ./spawn_monkey_patch.js node_modules/electron-builder/out/cli/cli.js --win portable",
    "postdist": "node embed-env-for-dist.js --post",
    "dist:mac": "node ../scripts/build-mac.mjs",
    "dist:mac:arm64": "node ../scripts/build-mac.mjs --arch arm64",
    "dist:mac:x64": "node ../scripts/build-mac.mjs --arch x64"
  },
  "dependencies": {
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  }
}
