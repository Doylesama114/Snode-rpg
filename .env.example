# DeepSeek API（复制为 .env 并填入真实 key，勿提交 git）
DEEPSEEK_API_KEY=

# 默认 deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：API 基址
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 生成参数（可选）
# DEEPSEEK_TEMPERATURE=0.3
# DEEPSEEK_MAX_TOKENS=3072

# 默认是否开启 thinking：0=关 1=开（CLI --thinking 可覆盖）
DEEPSEEK_THINKING=0

# 阿里云百炼 qwen-vl（describe_screenshot.mjs 免费模型降级备用，可选）
# 获取：https://bailian.console.aliyun.com → API-KEY 管理（qwen-vl-plus 约 0.0015 元/千 token）
# QWEN_API_KEY=sk-...
